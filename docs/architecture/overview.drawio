<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" type="device">
  <diagram id="page_1" name="01 输入与分支选择">
    <mxGraphModel dx="1600" dy="1800" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1600" pageHeight="1750" background="#ffffff"><root>
      <mxCell id="0" /><mxCell id="1" parent="0" />
      <mxCell id="note_title" value="01 输入与分支选择" style="text;html=0;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#17324D;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1480" height="40" as="geometry" /></mxCell>
      <mxCell id="note_summary" value="先判断是否执行,沿用已有选择;未选择时由当前任务负责内部拆分.&#10;绿色为默认路径.蓝色为显式选择.箭头是条件路由,不是时间刻度.委派、承载和迭代可组合,不是互斥模式.&#10;实线:条件与交付方向.虚线:需条件成立的返修、再检查或后继接管;均非无限循环." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontColor=#44546A;" vertex="1" parent="1"><mxGeometry x="40" y="940" width="1480" height="110" as="geometry" /></mxCell>
      <mxCell id="mod_discuss" value="仅讨论 / 解释 / 不派发" style="rounded=1;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=17;fontFamily=Microsoft YaHei;spacing=14;fillColor=#F3F6FA;strokeColor=#6E8299;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="280" height="70" as="geometry" /></mxCell>
      <mxCell id="mod_no_dispatch" value="不派发执行任务" style="rounded=1;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=17;fontFamily=Microsoft YaHei;spacing=14;fillColor=#F3F6FA;strokeColor=#6E8299;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="280" width="280" height="80" as="geometry" /></mxCell>
      <mxCell id="mod_execute" value="明确调用 Skill 执行" style="rounded=1;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=17;fontFamily=Microsoft YaHei;spacing=14;fillColor=#F3F6FA;strokeColor=#6E8299;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="420" y="100" width="300" height="70" as="geometry" /></mxCell>
      <mxCell id="mod_continue" value="已有选择后说:继续" style="rounded=1;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=17;fontFamily=Microsoft YaHei;spacing=14;fillColor=#F3F6FA;strokeColor=#6E8299;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="820" y="100" width="300" height="70" as="geometry" /></mxCell>
      <mxCell id="mod_choices" value="复用已有选择&#10;默认只补尚未选择的项" style="rounded=1;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=17;fontFamily=Microsoft YaHei;spacing=14;fillColor=#F3F6FA;strokeColor=#6E8299;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="420" y="280" width="300" height="80" as="geometry" /></mxCell>
      <mxCell id="mod_current" value="默认:当前任务负责&#10;内部 Agent 拆分 · 一批交付" style="rounded=1;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=17;fontFamily=Microsoft YaHei;spacing=14;fillColor=#E5F4EC;strokeColor=#278353;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="500" width="280" height="100" as="geometry" /></mxCell>
      <mxCell id="mod_delegate" value="显式:委派新负责人 E&#10;E 默认内部拆分" style="rounded=1;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=17;fontFamily=Microsoft YaHei;spacing=14;fillColor=#E8F1FF;strokeColor=#3B70AD;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="420" y="500" width="300" height="100" as="geometry" /></mxCell>
      <mxCell id="mod_side_split" value="显式:多个 Codex 任务&#10;各任务进入内部拆分选择" style="rounded=1;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=17;fontFamily=Microsoft YaHei;spacing=14;fillColor=#E8F1FF;strokeColor=#3B70AD;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="820" y="500" width="300" height="100" as="geometry" /></mxCell>
      <mxCell id="mod_iteration" value="显式:迭代 / GOAL 接力&#10;每轮进入内部拆分选择" style="rounded=1;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=17;fontFamily=Microsoft YaHei;spacing=14;fillColor=#E8F1FF;strokeColor=#3B70AD;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1220" y="500" width="300" height="100" as="geometry" /></mxCell>
      <mxCell id="mod_limits" value="执行前核验实际权限与能力&#10;数量 · 层级 · 单写者 · 输入就绪" style="rounded=1;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=17;fontFamily=Microsoft YaHei;spacing=14;fillColor=#FFF3D6;strokeColor=#A77C25;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="580" y="780" width="420" height="90" as="geometry" /></mxCell>
      <mxCell id="edge_1" value="讨论到此" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#66788A;fontColor=#34465B;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="mod_discuss" target="mod_no_dispatch"><mxGeometry relative="1" as="geometry" /></mxCell>
      <mxCell id="edge_2" value="明确目标后" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#66788A;fontColor=#34465B;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="mod_execute" target="mod_choices"><mxGeometry relative="1" as="geometry" /></mxCell>
      <mxCell id="edge_3" value="沿用有效上下文" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#66788A;fontColor=#34465B;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="mod_continue" target="mod_choices"><mxGeometry relative="1" as="geometry" /></mxCell>
      <mxCell id="edge_4" value="未明确另选" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#66788A;fontColor=#34465B;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="mod_choices" target="mod_current"><mxGeometry relative="1" as="geometry" /></mxCell>
      <mxCell id="edge_5" value="明确委派" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#66788A;fontColor=#34465B;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="mod_choices" target="mod_delegate"><mxGeometry relative="1" as="geometry" /></mxCell>
      <mxCell id="edge_6" value="明确多任务" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#66788A;fontColor=#34465B;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="mod_choices" target="mod_side_split"><mxGeometry relative="1" as="geometry" /></mxCell>
      <mxCell id="edge_7" value="明确迭代" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#66788A;fontColor=#34465B;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="mod_choices" target="mod_iteration"><mxGeometry relative="1" as="geometry" /></mxCell>
      <mxCell id="edge_8" value="进入执行" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#66788A;fontColor=#34465B;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="mod_current" target="mod_limits"><mxGeometry relative="1" as="geometry" /></mxCell>
      <mxCell id="edge_9" value="创建前" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#66788A;fontColor=#34465B;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="mod_delegate" target="mod_limits"><mxGeometry relative="1" as="geometry" /></mxCell>
      <mxCell id="edge_10" value="派发前" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#66788A;fontColor=#34465B;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="mod_side_split" target="mod_limits"><mxGeometry relative="1" as="geometry" /></mxCell>
      <mxCell id="edge_11" value="固定契约" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#66788A;fontColor=#34465B;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="mod_iteration" target="mod_limits"><mxGeometry relative="1" as="geometry" /></mxCell>
    </root></mxGraphModel>
  </diagram>
  <diagram id="page_2" name="02 默认执行:内部 Agent 与一次交付">
    <mxGraphModel dx="1600" dy="1800" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1600" pageHeight="1750" background="#ffffff"><root>
      <mxCell id="0" /><mxCell id="1" parent="0" />
      <mxCell id="note_title" value="02 默认执行:内部 Agent 与一次交付" style="text;html=0;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#17324D;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1480" height="40" as="geometry" /></mxCell>
      <mxCell id="note_summary" value="负责人一次给出完整工作包,Agent 自主闭环;负责人收齐后整合、验证、文档收口.&#10;所有执行负责人都适用,包括多个 Codex 任务中的每个任务及每轮迭代.普通子 Agent 是叶子.必要修复属于同一批,不自动续轮.&#10;实线:条件与交付方向.虚线:需条件成立的返修、再检查或后继接管;均非无限循环." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontColor=#44546A;" vertex="1" parent="1"><mxGeometry x="40" y="1360" width="1480" height="110" as="geometry" /></mxCell>
      <mxCell id="mod_owner" value="执行负责人&#10;当前任务 / 新负责人 / 轮次负责人" style="rounded=1;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=17;fontFamily=Microsoft YaHei;spacing=14;fillColor=#F3F6FA;strokeColor=#6E8299;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="450" y="70" width="340" height="80" as="geometry" /></mxCell>
      <mxCell id="mod_split_check" value="明确不拆分?&#10;否则是否存在合理拆分收益?" style="rounded=1;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=17;fontFamily=Microsoft YaHei;spacing=14;fillColor=#FFF3D6;strokeColor=#A77C25;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="450" y="230" width="340" height="90" as="geometry" /></mxCell>
      <mxCell id="mod_solo" value="负责人独立完成" style="rounded=1;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=17;fontFamily=Microsoft YaHei;spacing=14;fillColor=#F3F6FA;strokeColor=#6E8299;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="440" width="300" height="90" as="geometry" /></mxCell>
      <mxCell id="mod_package" value="按独立成果派发完整任务包&#10;先满足输入、依赖和所有权" style="rounded=1;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=17;fontFamily=Microsoft YaHei;spacing=14;fillColor=#E5F4EC;strokeColor=#278353;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="450" y="440" width="340" height="90" as="geometry" /></mxCell>
      <mxCell id="mod_agents" value="内部 Agent 自主闭环&#10;调查 → 实施 → 自查与验证" style="rounded=1;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=17;fontFamily=Microsoft YaHei;spacing=14;fillColor=#E5F4EC;strokeColor=#278353;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="450" y="620" width="340" height="90" as="geometry" /></mxCell>
      <mxCell id="mod_wait" value="负责人处理独立工作&#10;等待必需结果时用事件等待" style="rounded=1;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=17;fontFamily=Microsoft YaHei;spacing=14;fillColor=#F3F6FA;strokeColor=#6E8299;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="900" y="620" width="340" height="90" as="geometry" /></mxCell>
      <mxCell id="mod_integrate" value="收齐并审查必需成果&#10;集中返修 / 整合 / 最终验证" style="rounded=1;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=17;fontFamily=Microsoft YaHei;spacing=14;fillColor=#E5F4EC;strokeColor=#278353;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="450" y="820" width="340" height="90" as="geometry" /></mxCell>
      <mxCell id="mod_document" value="完成必要文档收口&#10;共享文档指定唯一写者" style="rounded=1;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=17;fontFamily=Microsoft YaHei;spacing=14;fillColor=#E5F4EC;strokeColor=#278353;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="450" y="1010" width="340" height="90" as="geometry" /></mxCell>
      <mxCell id="mod_delivery" value="统一交付这一批&#10;直接执行给用户;委派后回所属接收方" style="rounded=1;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=17;fontFamily=Microsoft YaHei;spacing=14;fillColor=#E5F4EC;strokeColor=#278353;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="450" y="1200" width="400" height="90" as="geometry" /></mxCell>
      <mxCell id="mod_block" value="真实阻塞 / 风险 / 用户暂停&#10;说明状态并处理必要协调" style="rounded=1;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=17;fontFamily=Microsoft YaHei;spacing=14;fillColor=#FDEBE7;strokeColor=#B65C49;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="900" y="1010" width="340" height="90" as="geometry" /></mxCell>
      <mxCell id="edge_1" value="确认拆分选择" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#66788A;fontColor=#34465B;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="mod_owner" target="mod_split_check"><mxGeometry relative="1" as="geometry" /></mxCell>
      <mxCell id="edge_2" value="不拆分 / 无合理拆分点" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#66788A;fontColor=#34465B;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="mod_split_check" target="mod_solo"><mxGeometry relative="1" as="geometry" /></mxCell>
      <mxCell id="edge_3" value="默认:有收益且可派发" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#66788A;fontColor=#34465B;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="mod_split_check" target="mod_package"><mxGeometry relative="1" as="geometry" /></mxCell>
      <mxCell id="edge_4" value="完整工作包" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#66788A;fontColor=#34465B;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="mod_package" target="mod_agents"><mxGeometry relative="1" as="geometry" /></mxCell>
      <mxCell id="edge_5" value="负责人并行独立工作" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#66788A;fontColor=#34465B;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="mod_package" target="mod_wait"><mxGeometry relative="1" as="geometry" /></mxCell>
      <mxCell id="edge_6" value="交付范围内成果" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#66788A;fontColor=#34465B;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="mod_agents" target="mod_integrate"><mxGeometry relative="1" as="geometry" /></mxCell>
      <mxCell id="edge_7" value="必需结果齐备" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#66788A;fontColor=#34465B;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="mod_wait" target="mod_integrate"><mxGeometry relative="1" as="geometry" /></mxCell>
      <mxCell id="edge_8" value="完成实现和自查" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#66788A;fontColor=#34465B;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="mod_solo" target="mod_integrate"><mxGeometry relative="1" as="geometry" /></mxCell>
      <mxCell id="edge_9" value="集中返修(适用时)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#66788A;fontColor=#34465B;fontSize=15;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="mod_integrate" target="mod_agents"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="360" y="865" /><mxPoint x="360" y="665" /></Array></mxGeometry></mxCell>
      <mxCell id="edge_10" value="最终候选验证通过" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#66788A;fontColor=#34465B;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="mod_integrate" target="mod_document"><mxGeometry relative="1" as="geometry" /></mxCell>
      <mxCell id="edge_11" value="交付前收口" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#66788A;fontColor=#34465B;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="mod_document" target="mod_delivery"><mxGeometry relative="1" as="geometry" /></mxCell>
      <mxCell id="edge_12" value="无法范围内解决" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#66788A;fontColor=#34465B;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="mod_integrate" target="mod_block"><mxGeometry relative="1" as="geometry" /></mxCell>
      <mxCell id="edge_13" value="按部分/阻塞等实际状态交付" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#66788A;fontColor=#34465B;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="mod_block" target="mod_delivery"><mxGeometry relative="1" as="geometry" /></mxCell>
    </root></mxGraphModel>
  </diagram>
  <diagram id="page_3" name="03 显式侧栏任务:回传与整合">
    <mxGraphModel dx="1600" dy="1800" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1600" pageHeight="2160" background="#ffffff"><root>
      <mxCell id="0" /><mxCell id="1" parent="0" />
      <mxCell id="note_title" value="03 显式侧栏任务:回传与整合" style="text;html=0;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#17324D;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1480" height="40" as="geometry" /></mxCell>
      <mxCell id="note_summary" value="先核验交付路径,各任务向所属负责人回传;必要结果就绪后才整合或汇总.&#10;返回路径:直接拆分 A/B → 当前负责人;委派 E → 原任务;委派再拆分 A/B → E → 原任务.不越级回传.&#10;实线:条件与交付方向.虚线:需条件成立的返修、再检查或后继接管;均非无限循环." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontColor=#44546A;" vertex="1" parent="1"><mxGeometry x="40" y="2000" width="1480" height="110" as="geometry" /></mxCell>
      <mxCell id="mod_sidebar" value="已明确选择侧栏任务&#10;固定负责人、批次和必要成果" style="rounded=1;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=17;fontFamily=Microsoft YaHei;spacing=14;fillColor=#E8F1FF;strokeColor=#3B70AD;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="450" y="70" width="360" height="90" as="geometry" /></mxCell>
      <mxCell id="mod_channel" value="核验交付方式&#10;准确 ID · 能力 · 人类授权" style="rounded=1;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=17;fontFamily=Microsoft YaHei;spacing=14;fillColor=#FFF3D6;strokeColor=#A77C25;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="450" y="250" width="360" height="90" as="geometry" /></mxCell>
      <mxCell id="mod_callback" value="回传已核验&#10;无本地在途工作可先结束回合" style="rounded=1;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=17;fontFamily=Microsoft YaHei;spacing=14;fillColor=#F3F6FA;strokeColor=#6E8299;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="50" y="450" width="350" height="100" as="geometry" /></mxCell>
      <mxCell id="mod_wait_choice" value="用户明确等待 / 仅交接&#10;遵守该选择" style="rounded=1;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=17;fontFamily=Microsoft YaHei;spacing=14;fillColor=#F3F6FA;strokeColor=#6E8299;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="950" y="450" width="350" height="100" as="geometry" /></mxCell>
      <mxCell id="mod_path_missing" value="能力或授权不足&#10;报告具体限制,补必要缺口" style="rounded=1;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=17;fontFamily=Microsoft YaHei;spacing=14;fillColor=#FDEBE7;strokeColor=#B65C49;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="950" y="250" width="350" height="90" as="geometry" /></mxCell>
      <mxCell id="mod_result" value="执行方完成后交付紧凑结果&#10;子结果先由所属负责人整合" style="rounded=1;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=17;fontFamily=Microsoft YaHei;spacing=14;fillColor=#F3F6FA;strokeColor=#6E8299;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="450" y="1050" width="360" height="100" as="geometry" /></mxCell>
      <mxCell id="mod_ready" value="按批次与任务标识去重&#10;全部必要成果是否真的就绪?" style="rounded=1;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=17;fontFamily=Microsoft YaHei;spacing=14;fillColor=#FFF3D6;strokeColor=#A77C25;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="450" y="1260" width="360" height="90" as="geometry" /></mxCell>
      <mxCell id="mod_partial" value="部分结果:记录并等余项&#10;重复/迟到:不重复计数或派发" style="rounded=1;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=17;fontFamily=Microsoft YaHei;spacing=14;fillColor=#F3F6FA;strokeColor=#6E8299;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="950" y="1260" width="350" height="90" as="geometry" /></mxCell>
      <mxCell id="mod_merge_choice" value="需要合并、联调或组合验证?" style="rounded=1;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=17;fontFamily=Microsoft YaHei;spacing=14;fillColor=#FFF3D6;strokeColor=#A77C25;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="450" y="1450" width="360" height="90" as="geometry" /></mxCell>
      <mxCell id="mod_merge" value="执行负责人整合&#10;新整合任务仅在明确授权内创建" style="rounded=1;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=17;fontFamily=Microsoft YaHei;spacing=14;fillColor=#F3F6FA;strokeColor=#6E8299;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="50" y="1640" width="370" height="100" as="geometry" /></mxCell>
      <mxCell id="mod_accept" value="汇总并最终验收&#10;独立结论可直接汇总" style="rounded=1;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=17;fontFamily=Microsoft YaHei;spacing=14;fillColor=#F3F6FA;strokeColor=#6E8299;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="650" y="1840" width="360" height="90" as="geometry" /></mxCell>
      <mxCell id="edge_1" value="派发前核验" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#66788A;fontColor=#34465B;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="mod_sidebar" target="mod_channel"><mxGeometry relative="1" as="geometry" /></mxCell>
      <mxCell id="edge_2" value="使用回传且条件齐备" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#66788A;fontColor=#34465B;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="mod_channel" target="mod_callback"><mxGeometry relative="1" as="geometry" /></mxCell>
      <mxCell id="edge_3" value="已选等待 / 仅交接" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#66788A;fontColor=#34465B;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="mod_channel" target="mod_wait_choice"><mxGeometry relative="1" as="geometry" /></mxCell>
      <mxCell id="edge_4" value="必要条件缺失" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#66788A;fontColor=#34465B;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="mod_channel" target="mod_path_missing"><mxGeometry relative="1" as="geometry" /></mxCell>
      <mxCell id="edge_5" value="执行任务启动后" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#66788A;fontColor=#34465B;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="mod_callback" target="mod_side_choice"><mxGeometry relative="1" as="geometry" /></mxCell>
      <mxCell id="edge_6" value="执行任务启动后" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#66788A;fontColor=#34465B;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="mod_wait_choice" target="mod_side_choice"><mxGeometry relative="1" as="geometry" /></mxCell>
      <mxCell id="edge_7" value="接收真实交付" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#66788A;fontColor=#34465B;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="mod_result" target="mod_ready"><mxGeometry relative="1" as="geometry" /></mxCell>
      <mxCell id="edge_8" value="未齐 / 重复 / 未就绪" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#66788A;fontColor=#34465B;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="mod_ready" target="mod_partial"><mxGeometry relative="1" as="geometry" /></mxCell>
      <mxCell id="edge_9" value="新有效成果到达" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#66788A;fontColor=#34465B;fontSize=15;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="mod_partial" target="mod_ready"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1390" y="1305" /><mxPoint x="1390" y="1305" /></Array></mxGeometry></mxCell>
      <mxCell id="edge_10" value="必要成果齐备且可用" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#66788A;fontColor=#34465B;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="mod_ready" target="mod_merge_choice"><mxGeometry relative="1" as="geometry" /></mxCell>
      <mxCell id="edge_11" value="需要组合验证" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#66788A;fontColor=#34465B;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="mod_merge_choice" target="mod_merge"><mxGeometry relative="1" as="geometry" /></mxCell>
      <mxCell id="edge_12" value="独立结论" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#66788A;fontColor=#34465B;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="mod_merge_choice" target="mod_accept"><mxGeometry relative="1" as="geometry" /></mxCell>
      <mxCell id="edge_13" value="统一交付" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#66788A;fontColor=#34465B;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="mod_merge" target="mod_accept"><mxGeometry relative="1" as="geometry" /></mxCell>
    <mxCell id="mod_side_choice" value="每个 Codex 执行负责人&#10;沿用自己的内部拆分选择" style="rounded=1;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=17;fontFamily=Microsoft YaHei;spacing=14;fillColor=#FFF3D6;strokeColor=#A77C25;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="450" y="650" width="360" height="90" as="geometry" /></mxCell>
      <mxCell id="mod_side_agents" value="默认:拆给内部 Agent&#10;子结果只交所属任务负责人" style="rounded=1;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=17;fontFamily=Microsoft YaHei;spacing=14;fillColor=#E5F4EC;strokeColor=#278353;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="80" y="850" width="360" height="90" as="geometry" /></mxCell>
      <mxCell id="mod_side_solo" value="明确不拆分&#10;该 Codex 任务独立完成" style="rounded=1;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=17;fontFamily=Microsoft YaHei;spacing=14;fillColor=#E5F4EC;strokeColor=#278353;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="900" y="850" width="360" height="90" as="geometry" /></mxCell>
      <mxCell id="edge_side_default" value="默认:有实际拆分收益" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#66788A;fontColor=#34465B;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="mod_side_choice" target="mod_side_agents"><mxGeometry relative="1" as="geometry" /></mxCell>
      <mxCell id="edge_side_solo" value="明确不拆分 / 无合理拆分点" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#66788A;fontColor=#34465B;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="mod_side_choice" target="mod_side_solo"><mxGeometry relative="1" as="geometry" /></mxCell>
      <mxCell id="edge_side_collect" value="收齐、验证及文档收口" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#66788A;fontColor=#34465B;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="mod_side_agents" target="mod_result"><mxGeometry relative="1" as="geometry" /></mxCell>
      <mxCell id="edge_side_finish" value="自查、验证及文档收口" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#66788A;fontColor=#34465B;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="mod_side_solo" target="mod_result"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root></mxGraphModel>
  </diagram>
  <diagram id="page_4" name="04 显式迭代:GOAL 有界串行接力">
    <mxGraphModel dx="1600" dy="1800" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1600" pageHeight="1790" background="#ffffff"><root>
      <mxCell id="0" /><mxCell id="1" parent="0" />
      <mxCell id="note_title" value="04 显式迭代:GOAL 有界串行接力" style="text;html=0;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#17324D;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1480" height="40" as="geometry" /></mxCell>
      <mxCell id="note_summary" value="每轮从项目资料接续;只有验收提交完成、写者结束且边界允许,才创建唯一后继.&#10;每轮默认内部拆分,明确不拆分则本轮独立完成;轮次仍串行.普通一批交付不会自动走到这里,已有 GOAL 文件也不触发迭代.&#10;实线:条件与交付方向.虚线:需条件成立的返修、再检查或后继接管;均非无限循环." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontColor=#44546A;" vertex="1" parent="1"><mxGeometry x="40" y="1630" width="1480" height="110" as="geometry" /></mxCell>
      <mxCell id="mod_goal_contract" value="明确迭代并固定契约&#10;目标 · 验收 · 上限 · 授权 · 交付方式" style="rounded=1;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=17;fontFamily=Microsoft YaHei;spacing=14;fillColor=#E8F1FF;strokeColor=#3B70AD;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="450" y="70" width="380" height="100" as="geometry" /></mxCell>
      <mxCell id="mod_round" value="本轮负责人接管&#10;读取 GOAL、规则与当前证据" style="rounded=1;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=17;fontFamily=Microsoft YaHei;spacing=14;fillColor=#F3F6FA;strokeColor=#6E8299;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="450" y="270" width="380" height="90" as="geometry" /></mxCell>
      <mxCell id="mod_slice" value="自主完成可验收切片&#10;收齐结果、验证、文档收口" style="rounded=1;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=17;fontFamily=Microsoft YaHei;spacing=14;fillColor=#F3F6FA;strokeColor=#6E8299;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="450" y="860" width="380" height="90" as="geometry" /></mxCell>
      <mxCell id="mod_stop_check" value="达标 / 无有价值下一项 / 必须停止?" style="rounded=1;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=17;fontFamily=Microsoft YaHei;spacing=14;fillColor=#FFF3D6;strokeColor=#A77C25;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="450" y="1050" width="380" height="90" as="geometry" /></mxCell>
      <mxCell id="mod_handoff_gate" value="未达标:续轮条件全部满足?&#10;验收提交 · 就绪输入 · 授权 · 边界" style="rounded=1;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=17;fontFamily=Microsoft YaHei;spacing=14;fillColor=#FFF3D6;strokeColor=#A77C25;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="450" y="1250" width="380" height="100" as="geometry" /></mxCell>
      <mxCell id="mod_freeze" value="确认写者结束并冻结仓库操作&#10;创建唯一下一轮,初始核验后退出" style="rounded=1;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=17;fontFamily=Microsoft YaHei;spacing=14;fillColor=#F3F6FA;strokeColor=#6E8299;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="450" y="1460" width="380" height="100" as="geometry" /></mxCell>
      <mxCell id="mod_stop_report" value="终止轮汇总整批状态与停止原因&#10;按固定方式向原主任务或用户交付" style="rounded=1;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=17;fontFamily=Microsoft YaHei;spacing=14;fillColor=#FDEBE7;strokeColor=#B65C49;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1010" y="1250" width="390" height="110" as="geometry" /></mxCell>
      <mxCell id="edge_1" value="首轮启动" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#66788A;fontColor=#34465B;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="mod_goal_contract" target="mod_round"><mxGeometry relative="1" as="geometry" /></mxCell>
      <mxCell id="edge_2" value="所有权与输入确认" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#66788A;fontColor=#34465B;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="mod_round" target="mod_round_choice"><mxGeometry relative="1" as="geometry" /></mxCell>
      <mxCell id="edge_3" value="本轮评估" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#66788A;fontColor=#34465B;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="mod_slice" target="mod_stop_check"><mxGeometry relative="1" as="geometry" /></mxCell>
      <mxCell id="edge_4" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#66788A;fontColor=#34465B;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="mod_stop_check" target="mod_stop_report"><mxGeometry relative="1" as="geometry" /></mxCell>
      <mxCell id="edge_5" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#66788A;fontColor=#34465B;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="mod_stop_check" target="mod_handoff_gate"><mxGeometry relative="1" as="geometry" /></mxCell>
      <mxCell id="edge_6" value="条件不满足" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#66788A;fontColor=#34465B;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="mod_handoff_gate" target="mod_stop_report"><mxGeometry relative="1" as="geometry" /></mxCell>
      <mxCell id="edge_7" value="全部满足" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#66788A;fontColor=#34465B;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="mod_handoff_gate" target="mod_freeze"><mxGeometry relative="1" as="geometry" /></mxCell>
      <mxCell id="edge_8" value="唯一后继接管" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#66788A;fontColor=#34465B;fontSize=15;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="mod_freeze" target="mod_round"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="240" y="1510" /><mxPoint x="240" y="315" /></Array></mxGeometry></mxCell>
    <mxCell id="mod_round_choice" value="本轮负责人的拆分选择&#10;沿用本轮 / 整批明确约定" style="rounded=1;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=17;fontFamily=Microsoft YaHei;spacing=14;fillColor=#FFF3D6;strokeColor=#A77C25;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="450" y="460" width="380" height="90" as="geometry" /></mxCell>
      <mxCell id="mod_round_agents" value="默认:拆给内部 Agent&#10;结果先交本轮负责人" style="rounded=1;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=17;fontFamily=Microsoft YaHei;spacing=14;fillColor=#E5F4EC;strokeColor=#278353;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="80" y="650" width="360" height="90" as="geometry" /></mxCell>
      <mxCell id="mod_round_solo" value="明确不拆分&#10;本轮任务独立完成" style="rounded=1;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=17;fontFamily=Microsoft YaHei;spacing=14;fillColor=#E5F4EC;strokeColor=#278353;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="900" y="650" width="360" height="90" as="geometry" /></mxCell>
      <mxCell id="edge_round_default" value="默认:有实际拆分收益" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#66788A;fontColor=#34465B;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="mod_round_choice" target="mod_round_agents"><mxGeometry relative="1" as="geometry" /></mxCell>
      <mxCell id="edge_round_solo" value="明确不拆分 / 无合理拆分点" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#66788A;fontColor=#34465B;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="mod_round_choice" target="mod_round_solo"><mxGeometry relative="1" as="geometry" /></mxCell>
      <mxCell id="edge_round_collect" value="本轮负责人收齐并整合" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#66788A;fontColor=#34465B;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="mod_round_agents" target="mod_slice"><mxGeometry relative="1" as="geometry" /></mxCell>
      <mxCell id="edge_round_finish" value="自主实施后收口" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#66788A;fontColor=#34465B;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="mod_round_solo" target="mod_slice"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root></mxGraphModel>
  </diagram>
